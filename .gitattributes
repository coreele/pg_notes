# Normalize line endings: LF in repo and working tree
* text=auto eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Shell / git hooks — always LF
*.sh text eol=lf
.githooks/** text eol=lf

# Binary — do not touch
*.{png,jpg,jpeg,gif,webp,ico,svg,pdf,zip,gz,mp4,woff,woff2,ttf,eot} binary
*.{dll,exe,so,dylib,a,o,obj} binary
